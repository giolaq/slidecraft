{
  "name": "slidecraft-mcp",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.5.0",
  "description": "Animated presentation authoring for ChatGPT and MCP clients",
  "author": "Giovanni Laquidara",
  "license": "MIT",
  "homepage": "https://github.com/giolaq/slidecraft",
  "keywords": [
    "mcp",
    "mcp-server",
    "chatgpt plugins",
    "claude connector",
    "mcp-app",
    "mcp-use",
    "manufact"
  ],
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "test:mcp": "node tests/mcp-check.mjs",
    "test:widget": "node tests/widget-check.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fast-json-patch": "^3.1.1",
    "ipaddr.js": "^2.5.0",
    "mcp-use": "2.8.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mcp-use/client": "^2.4.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
